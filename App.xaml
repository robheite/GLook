<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="GLook.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GLook"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="GLookCanvasBrush" Color="#F5F8FE" />
                    <SolidColorBrush x:Key="GLookPaneBrush" Color="#EAF2FF" />
                    <SolidColorBrush x:Key="GLookThreadBrush" Color="#F7FAFF" />
                    <SolidColorBrush x:Key="GLookReadingBrush" Color="#FCFDFF" />
                    <SolidColorBrush x:Key="GLookSeparatorBrush" Color="#244B6FA8" />
                    <SolidColorBrush x:Key="GLookMutedBrush" Color="#66758F" />
                    <SolidColorBrush x:Key="GLookBrandBrush" Color="#0D5BD7" />
                    <SolidColorBrush x:Key="GLookBrandStrongBrush" Color="#0A3F9A" />
                    <SolidColorBrush x:Key="GLookBrandSoftBrush" Color="#DCEAFF" />
                    <SolidColorBrush x:Key="GLookCoralBrush" Color="#E5483F" />
                    <SolidColorBrush x:Key="GLookSyncBrush" Color="#166534" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0D5BD7" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#176BE3" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#0A4FBF" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#0A4FBF" />
                    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#0A3F9A" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="GLookCanvasBrush" Color="#08111F" />
                    <SolidColorBrush x:Key="GLookPaneBrush" Color="#0B1A31" />
                    <SolidColorBrush x:Key="GLookThreadBrush" Color="#0D1728" />
                    <SolidColorBrush x:Key="GLookReadingBrush" Color="#091321" />
                    <SolidColorBrush x:Key="GLookSeparatorBrush" Color="#307DB6FF" />
                    <SolidColorBrush x:Key="GLookMutedBrush" Color="#AABAD4" />
                    <SolidColorBrush x:Key="GLookBrandBrush" Color="#48A8FF" />
                    <SolidColorBrush x:Key="GLookBrandStrongBrush" Color="#7EC2FF" />
                    <SolidColorBrush x:Key="GLookBrandSoftBrush" Color="#17365F" />
                    <SolidColorBrush x:Key="GLookCoralBrush" Color="#FF756B" />
                    <SolidColorBrush x:Key="GLookSyncBrush" Color="#72D89A" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#1479E8" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#238AF3" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#0D68CE" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#70BBFF" />
                    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#9DD0FF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="GLookCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GLookPaneBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GLookThreadBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GLookReadingBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GLookSeparatorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="GLookMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="GLookBrandBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="GLookBrandStrongBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="GLookBrandSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GLookCoralBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="GLookSyncBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="GLookSectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource GLookMutedBrush}" />
                <Setter Property="CharacterSpacing" Value="40" />
            </Style>

            <Style x:Key="GLookMetadataStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource GLookMutedBrush}" />
            </Style>

            <Style x:Key="GLookListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="4,1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
