<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="GLook.Views.BoardView"
    x:Name="View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GLook.Models"
    mc:Ignorable="d">
    <Grid Background="{ThemeResource GLookCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar
            Grid.Row="0"
            AutomationProperties.Name="Board view commands"
            Background="{ThemeResource GLookReadingBrush}"
            BorderBrush="{ThemeResource GLookSeparatorBrush}"
            BorderThickness="0,0,0,1"
            DefaultLabelPosition="Right"
            IsDynamicOverflowEnabled="True">
            <CommandBar.Content>
                <StackPanel Margin="8,0,16,0" Orientation="Horizontal" Spacing="10">
                    <TextBlock
                        Style="{StaticResource GLookSectionLabelStyle}"
                        Text="MAILBOX"
                        VerticalAlignment="Center" />
                    <ComboBox
                        x:Name="MailboxSelector"
                        MinWidth="240"
                        MaxWidth="420"
                        AutomationProperties.HelpText="Choose which connected Gmail mailbox appears on this board"
                        AutomationProperties.Name="Board mailbox"
                        ItemsSource="{x:Bind Mailboxes, Mode=OneWay}"
                        SelectionChanged="MailboxSelector_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:BoardMailboxOption">
                                <TextBlock Text="{x:Bind DisplayText}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </CommandBar.Content>
            <AppBarButton
                AutomationProperties.HelpText="Add, remove, reorder, rename, or map board columns"
                Click="ManageBoard_Click"
                Label="Manage board">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <ScrollViewer
            x:Name="BoardScrollViewer"
            Grid.Row="1"
            Padding="12"
            AutomationProperties.Name="Mail workflow board"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            SizeChanged="BoardScrollViewer_SizeChanged"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled"
            ZoomMode="Disabled">
            <ItemsControl
                x:Name="LaneItemsControl"
                ItemsSource="{x:Bind Lanes, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:BoardLaneViewModel">
                        <Grid
                            Width="320"
                            Margin="0,0,12,0"
                            Padding="12"
                            AutomationProperties.Name="{x:Bind AutomationName}"
                            Background="{ThemeResource GLookThreadBrush}"
                            CornerRadius="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        FontFamily="Segoe UI Variable Display"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        MaxLines="2"
                                        Text="{x:Bind Definition.DisplayTitle}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Style="{StaticResource GLookMetadataStyle}"
                                        Text="{x:Bind CountText}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    AutomationProperties.Name="Rename board column"
                                    Click="RenameColumn_Click"
                                    CommandParameter="{x:Bind}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Rename column">
                                    <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                </Button>
                            </Grid>

                            <TextBlock
                                Grid.Row="1"
                                Margin="0,4,0,10"
                                Style="{StaticResource GLookMetadataStyle}"
                                Text="{x:Bind BindingText}"
                                TextTrimming="CharacterEllipsis" />

                            <ListView
                                x:Name="MappedCardList"
                                Grid.Row="2"
                                x:Load="{x:Bind IsMapped}"
                                AutomationProperties.Name="{x:Bind Definition.DisplayTitle}"
                                IsItemClickEnabled="True"
                                ItemClick="CardList_ItemClick"
                                ItemsSource="{x:Bind Cards}"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource GLookListViewItemStyle}" TargetType="ListViewItem">
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:BoardCardItem">
                                        <Grid
                                            Padding="12,10"
                                            AutomationProperties.Name="{x:Bind AutomationName}"
                                            Background="{ThemeResource GLookReadingBrush}"
                                            CornerRadius="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    MaxLines="1"
                                                    Text="{x:Bind Sender}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Style="{StaticResource GLookMetadataStyle}"
                                                    Text="{x:Bind ReceivedText}" />
                                            </Grid>
                                            <TextBlock
                                                Grid.Row="1"
                                                Margin="0,4,0,0"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                MaxLines="2"
                                                Text="{x:Bind Subject}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Grid.Row="2"
                                                Margin="0,4,0,0"
                                                MaxLines="2"
                                                Style="{StaticResource GLookMetadataStyle}"
                                                Text="{x:Bind Preview}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Grid.Row="3"
                                                Margin="0,7,0,0"
                                                Style="{StaticResource GLookMetadataStyle}"
                                                Text="{x:Bind MailboxDisplayName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Row="4" Margin="0,9,0,0" Orientation="Horizontal" Spacing="6">
                                                <Button
                                                    MinHeight="32"
                                                    AutomationProperties.Name="Move conversation to another board column"
                                                    Click="MoveCard_Click"
                                                    CommandParameter="{x:Bind}"
                                                    Content="Move to" />
                                                <Button
                                                    MinHeight="32"
                                                    AutomationProperties.Name="Add another board label to conversation"
                                                    Click="AddLabelCard_Click"
                                                    CommandParameter="{x:Bind}"
                                                    Content="Add label" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel
                                x:Name="UnmappedLanePrompt"
                                Grid.Row="2"
                                x:Load="{x:Bind IsUnmapped}"
                                MaxWidth="250"
                                HorizontalAlignment="Center"
                                Spacing="12"
                                VerticalAlignment="Center">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    FontSize="28"
                                    Foreground="{ThemeResource GLookMutedBrush}"
                                    Glyph="&#xE8EC;" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="Choose or create Gmail label"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{StaticResource GLookMetadataStyle}"
                                    Text="Map this column for the selected mailbox before placing conversations here."
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <Button
                                    HorizontalAlignment="Center"
                                    AutomationProperties.Name="Choose or create Gmail label"
                                    Click="ChooseLabel_Click"
                                    CommandParameter="{x:Bind}"
                                    Content="Choose label" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid
            Grid.Row="2"
            Padding="12,8"
            Background="{ThemeResource GLookPaneBrush}"
            BorderBrush="{ThemeResource GLookSeparatorBrush}"
            BorderThickness="0,1,0,0">
            <TextBlock
                x:Name="BoardStatusText"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="Board status"
                Style="{StaticResource GLookMetadataStyle}"
                Text="Board ready"
                TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</UserControl>
