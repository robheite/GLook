<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GLook.Views.AccountsSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GLook.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        MaxWidth="720"
        HorizontalAlignment="Stretch"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock
                    FontFamily="Segoe UI Variable Display"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Mailboxes" />
                <TextBlock
                    Style="{StaticResource GLookMetadataStyle}"
                    Text="Each Gmail account keeps separate credentials, mail cache, sync state, and notifications."
                    TextWrapping="Wrap" />
            </StackPanel>
            <Button
                Grid.Column="1"
                MinWidth="40"
                MinHeight="40"
                AutomationProperties.Name="Add Gmail account"
                Click="AddAccount_Click"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="Add account" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar
            x:Name="AccountNotice"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False"
            Severity="Informational"
            Title="Account status" />

        <Grid Grid.Row="2">
            <ListView
                x:Name="AccountList"
                AutomationProperties.Name="Connected Gmail accounts"
                HorizontalContentAlignment="Stretch"
                IsItemClickEnabled="False"
                ItemsSource="{x:Bind Accounts}"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource GLookListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:AccountSettingsItemViewModel">
                        <Border
                            Padding="16"
                            AutomationProperties.Name="{x:Bind CardAutomationName, Mode=OneWay}"
                            Background="{ThemeResource GLookPaneBrush}"
                            BorderBrush="{ThemeResource GLookSeparatorBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBox
                                            AutomationProperties.Name="{x:Bind DisplayNameAutomationName, Mode=OneWay}"
                                            Header="Display label"
                                            LostFocus="DisplayName_LostFocus"
                                            Tag="{x:Bind AccountId}"
                                            Text="{x:Bind DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            AutomationProperties.Name="{x:Bind EmailAutomationName, Mode=OneWay}"
                                            IsTextSelectionEnabled="True"
                                            Style="{StaticResource GLookMetadataStyle}"
                                            Text="{x:Bind EmailAddress}" />
                                    </StackPanel>
                                    <FontIcon
                                        Grid.Column="1"
                                        Margin="8,20,4,0"
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontSize="24"
                                        Foreground="{ThemeResource GLookBrandBrush}"
                                        Glyph="&#xE77B;" />
                                </Grid>

                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleSwitch
                                        AutomationProperties.Name="{x:Bind SyncAutomationName, Mode=OneWay}"
                                        Header="Automatic sync"
                                        IsOn="{x:Bind AutomaticSyncEnabled, Mode=TwoWay}"
                                        OffContent="Off"
                                        OnContent="On"
                                        Tag="{x:Bind AccountId}"
                                        Toggled="AccountPreference_Toggled" />
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        AutomationProperties.Name="{x:Bind NotificationsAutomationName, Mode=OneWay}"
                                        Header="Windows notifications"
                                        IsOn="{x:Bind NotificationsEnabled, Mode=TwoWay}"
                                        OffContent="Off"
                                        OnContent="On"
                                        Tag="{x:Bind AccountId}"
                                        Toggled="AccountPreference_Toggled" />
                                </Grid>

                                <Border
                                    Padding="10,8"
                                    Background="{ThemeResource GLookReadingBrush}"
                                    CornerRadius="6">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontSize="14"
                                            Foreground="{ThemeResource GLookSyncBrush}"
                                            Glyph="&#xE895;" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{x:Bind SyncStatusText, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Style="{StaticResource GLookMetadataStyle}"
                                                Text="{x:Bind QuotaStatusText, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Style="{StaticResource GLookMetadataStyle}"
                                                Text="{x:Bind LastSyncText, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Button
                                        MinHeight="40"
                                        AutomationProperties.Name="{x:Bind MoveUpAutomationName, Mode=OneWay}"
                                        Click="MoveUp_Click"
                                        Content="Move up"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="{x:Bind CanMoveUp, Mode=OneWay}"
                                        Tag="{x:Bind AccountId}" />
                                    <Button
                                        Grid.Column="1"
                                        MinHeight="40"
                                        AutomationProperties.Name="{x:Bind MoveDownAutomationName, Mode=OneWay}"
                                        Click="MoveDown_Click"
                                        Content="Move down"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="{x:Bind CanMoveDown, Mode=OneWay}"
                                        Tag="{x:Bind AccountId}" />
                                    <Button
                                        Grid.Row="1"
                                        MinHeight="40"
                                        AutomationProperties.Name="{x:Bind ReauthorizeAutomationName, Mode=OneWay}"
                                        Click="Reauthorize_Click"
                                        Content="Reauthorize"
                                        HorizontalAlignment="Stretch"
                                        Tag="{x:Bind AccountId}" />
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        MinHeight="40"
                                        AutomationProperties.Name="{x:Bind RemoveAutomationName, Mode=OneWay}"
                                        Click="Remove_Click"
                                        Content="Remove"
                                        HorizontalAlignment="Stretch"
                                        Tag="{x:Bind AccountId}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                x:Name="EmptyState"
                MaxWidth="420"
                HorizontalAlignment="Center"
                Spacing="8"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <FontIcon
                    HorizontalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="32"
                    Foreground="{ThemeResource GLookMutedBrush}"
                    Glyph="&#xE77B;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="No Gmail accounts connected" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource GLookMetadataStyle}"
                    Text="Add an account to create its mailbox."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ProgressRing
                x:Name="LoadingIndicator"
                Width="32"
                Height="32"
                AutomationProperties.Name="Loading account settings"
                IsActive="False"
                Visibility="Collapsed" />
        </Grid>

        <TextBlock
            x:Name="AccountStatusAnnouncement"
            Grid.Row="3"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Account settings status"
            Style="{StaticResource GLookMetadataStyle}"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
